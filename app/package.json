{
  "name": "app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:model": "node --test --test-isolation=none tests/wrongbook-model.test.mjs",
    "test:backup": "node --test --test-isolation=none tests/wrongbook-backup.test.mjs",
    "test:ocr": "node --test --test-isolation=none tests/ocr.test.mjs",
    "test:prototype": "playwright test -c playwright.prototype.config.ts",
    "test:runtime": "playwright test",
    "test:native": "pnpm run build && pnpm run prepare:native && node --test --test-isolation=none tests/capacitor-config.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:release": "node --test --test-isolation=none tests/android-release.test.mjs",
    "predev": "node scripts/check-mobile-runtime.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/check-mobile-runtime.mjs",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "prepare:native": "node scripts/prepare-native-build.mjs",
    "native:sync": "pnpm run build && pnpm run prepare:native && cap sync && node scripts/normalize-capacitor-spm-paths.mjs",
    "native:android": "pnpm run native:sync && cap open android",
    "native:ios": "pnpm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.0",
    "@capacitor/share": "8.0.1",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
